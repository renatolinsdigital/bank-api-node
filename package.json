{
  "name": "accounts-api",
  "version": "1.0.0",
  "description": "Accounts API",
  "main": "dist/main.js",
  "type": "module",
  "scripts": {
    "start": "node --experimental-specifier-resolution=node dist/main.js",
    "dev": "tsx watch --experimental-specifier-resolution=node src/main.ts",
    "build": "tsc",
    "lint": "eslint . --ext .ts",
